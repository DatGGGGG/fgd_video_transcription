# OpenAI-compatible Compass Gateway
OPENAI_API_KEY=replace_me
OPENAI_BASE_URL=https://compass.llm.shopee.io/compass-api/v1
OPENAI_PROVIDER=OpenAI

# Model choices
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
OPENAI_TRANSCRIPTION_ENDPOINT=/audio/internal/transcriptions
GEMINI_MODEL=gemini-2.5-flash
OPENAI_VISION_MODEL=gpt-5.4-mini

# Rough estimate knobs for vision speaker assignment.
# Adjust these to match Compass/model pricing if finance/docs give different values.
OPENAI_VISION_TOKENS_PER_IMAGE=765
OPENAI_VISION_TEXT_TOKENS_PER_SEGMENT=350
OPENAI_VISION_OUTPUT_TOKENS_PER_SEGMENT=140
OPENAI_VISION_INPUT_COST_PER_1M=2.50
OPENAI_VISION_OUTPUT_COST_PER_1M=10.00

# Network knobs
OPENAI_TIMEOUT_SECONDS=300
OPENAI_MAX_RETRIES=3
